# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
DJANGO_TIME_ZONE=Africa/Dar_es_Salaam

# Database: use "postgres" in production, "sqlite" for a quick local start
DB_ENGINE=postgres
DB_NAME=tie
DB_USER=tie
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Frontend / email links
FRONTEND_URL=http://localhost:8080
API_PUBLIC_URL=

# CORS (only needed when the SPA and API are on different origins)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Email (password reset). Console backend prints the reset link in the server log.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=TIE <no-reply@tie.or.tz>

# Security (turn these on behind HTTPS)
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0

# Limits
MAX_INNOVATION_IMAGE_BYTES=5242880
MAX_INNOVATION_MEDIA_IMAGES=4
MAX_INNOVATION_MEDIA_VIDEOS=2
MAX_INNOVATION_MEDIA_IMAGE_BYTES=10485760
MAX_INNOVATION_VIDEO_BYTES=52428800
MAX_VIDEO_POSTER_BYTES=4194304
PRIVATE_MEDIA_ROOT=
MAX_AVATAR_BYTES=2097152
THROTTLE_ANON=120/min
THROTTLE_USER=600/min
THROTTLE_AUTH=15/min
